{
  "name": "argus-pentest",
  "version": "0.1.5",
  "description": "Terminal-first authorized security assessment harness: agentic pentesting, WSL/Kali tooling, live terminal, research reports.",
  "license": "UNLICENSED",
  "type": "module",
  "module": "src/cli.ts",
  "bin": {
    "argus": "src/cli.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.3.14"
  },
  "keywords": [
    "pentest",
    "security",
    "agent",
    "tui",
    "kali",
    "wsl",
    "nmap",
    "nuclei",
    "bug-bounty"
  ],
  "scripts": {
    "dev": "bun run src/tui/index.tsx",
    "tui": "bun run src/tui/index.tsx",
    "cli": "bun run src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test",
    "prepublishOnly": "bun run check",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@opentui/core": "^0.6.8",
    "@opentui/react": "^0.6.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
